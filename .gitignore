# ---- môi trường / IDE / agent cục bộ ----
.venv/
.vscode/
.claude/
__pycache__/
*.pyc

# ---- LaTeX build ----
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz

# ---- dữ liệu lớn: tải hoặc tạo lại được (xem bench/data/README.md) ----
datasets/
bench/data/is21/*.biasing_*.tsv
bench/protocol/*/audio.tsv
bench/protocol/*/ctx_*.json
