# ---- code bên thứ ba: clone lại theo bench/third_party/README.md ----
bench/third_party/*/

# ---- output nặng của scorer chỉ có trên server ----
scorer/work/
scorer/runs/2026-10-15/bias.idx

# ---- hướng cũ đã bỏ (giữ cục bộ, không đẩy lên) ----
archive/

# ---- chỉ dẫn riêng máy (tên, đường dẫn, server) ----
AGENTS.local.md
